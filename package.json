{
  "name": "effect-rstest",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A set of helpers for testing Effect (v4) code with Rstest — a port of @effect/vitest",
  "homepage": "https://github.com/ScriptedAlchemy/effect-rstest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScriptedAlchemy/effect-rstest.git"
  },
  "bugs": {
    "url": "https://github.com/ScriptedAlchemy/effect-rstest/issues"
  },
  "keywords": [
    "effect",
    "rstest",
    "testing",
    "typescript"
  ],
  "sideEffects": [],
  "packageManager": "pnpm@10.33.3",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/utils.ts --format esm --dts --clean",
    "check": "tsc --noEmit",
    "test": "rstest",
    "test:types": "tstyche",
    "prepublishOnly": "npm run build",
    "publint": "publint --strict"
  },
  "peerDependencies": {
    "@rstest/core": "^0.11.0",
    "effect": "^4.0.0-rc.108"
  },
  "devDependencies": {
    "@rstest/core": "^0.11.11",
    "@types/node": "^26.4.0",
    "effect": "4.0.0-rc.112",
    "pkg-pr-new": "0.0.88",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tstyche": "^7.2.3",
    "typescript": "^5.9.2"
  }
}
